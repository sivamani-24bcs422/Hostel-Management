# Docker Compose / production environment.
# For local development, use backend/.env (copy it from backend/.env.example).

JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Default Compose database service. Replace with an Atlas/remote URI if preferred.
MONGO_URI=mongodb://mongo:27017/hostel_management

# Public origin of the Dockerized app.
CLIENT_URL=http://localhost:3000

SEED_PASSWORD=Password@123
