# Optional root environment file.
# Local development and Docker Compose read backend/.env first.
# Some hosting platforms (including byteXL) inject variables here or in their
# dashboard; runtime variables always override backend/.env values.

JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# MongoDB connection string used by the app.
MONGO_URI=mongodb://127.0.0.1:27017/hostel_management

# Public origin of the deployed app.
CLIENT_URL=http://localhost:3000

SEED_PASSWORD=Password@123
