# Server
PORT=3000
NODE_ENV=development

# MongoDB
# Local example: mongodb://127.0.0.1:27017/hostel_management
# Remote/Atlas example: mongodb+srv://user:password@cluster.mongodb.net/hostel_management
# This file is copied into the Docker image, so the same URL is used on byteXL.
# MONGO_DB_URI is accepted as an alias (the original template used that name).
MONGO_URI=mongodb://127.0.0.1:27017/hostel_management

# Authentication
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin (comma separated for multiple origins).
# In Docker/production the SPA and API share an origin, which is allowed
# automatically. Add byteXL's public URL here if it uses a separate frontend.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Demo seed password (optional override)
SEED_PASSWORD=Password@123
