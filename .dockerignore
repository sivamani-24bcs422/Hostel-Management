# Dependencies and build output
**/node_modules
**/dist
**/build
coverage

# Secrets and local environment files.
# .env and backend/.env are intentionally NOT ignored because byteXL builds the
# image directly and the app reads its MongoDB URL from these files.
# Platform-provided environment variables still override them at runtime.
**/.env
**/.env.*
!**/.env.example
!backend/.env
!/.env

# Version control, editor and OS cruft
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.swp

# Documentation and local screenshots
README.md
*.png
